{
  "name": "undergrowth-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "shoot": "node tools/shoot.mjs",
    "log": "node tools/build-log.mjs",
    "check:ship": "node tools/check-ship.mjs",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tests/*.{js,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"tests/*.{js,mjs}\""
  },
  "dependencies": {
    "three": "^0.180.0",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prettier": "^3.9.6"
  }
}
